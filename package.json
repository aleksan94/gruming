{
  "name": "teplaya-lapka",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && eslint . --max-warnings 0 && stylelint \"**/*.{scss,vue}\" && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . && stylelint \"**/*.{scss,vue}\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.{scss,vue}\" --fix",
    "lint:style": "stylelint \"**/*.{scss,vue}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.0",
    "vite-svg-loader": "^5.1.3",
    "vue-tsc": "^3.3.12"
  }
}
